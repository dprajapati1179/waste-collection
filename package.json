{
  "name": "waste-collection",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @waste-collection/api dev",
    "dev:web": "pnpm --filter @waste-collection/web dev",
    "dev:mobile": "pnpm --filter @waste-collection/mobile start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.10.1"
}
