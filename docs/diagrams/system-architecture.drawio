<mxfile host="drawio"><diagram name="System Architecture" id="system-architecture"><mxGraphModel grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="System Architecture" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="600" height="40" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Collector Mobile App&lt;/b&gt;&lt;br&gt;Expo · React Native · Redux Toolkit&lt;br&gt;&lt;i&gt;scan QR, enter weight, submit&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="250" height="100" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Admin Web Dashboard&lt;/b&gt;&lt;br&gt;Next.js&lt;br&gt;&lt;i&gt;table of successful collections&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="250" height="100" as="geometry"/></mxCell><mxCell id="n4" value="REST API · Node.js + Express" style="swimlane;html=1;startSize=34;fontSize=15;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#fffdf3;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="500" y="60" width="300" height="420" as="geometry"/></mxCell><mxCell id="n5" value="Routes → Controllers" style="whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="260" height="44" as="geometry"/></mxCell><mxCell id="n6" value="Zod validation (strict schema)&lt;br&gt;&lt;i&gt;rejects unknown fields, e.g. points&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#d