<mxfile host="drawio"><diagram name="Failure Recovery" id="failure-recovery"><mxGraphModel grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Failure Recovery" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="600" height="40" as="geometry"/></mxCell><mxCell id="n2" value="Scan QR code&lt;br&gt;&lt;i&gt;Bag ID stored in Redux&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="200" height="56" as="geometry"/></mxCell><mxCell id="n3" value="Enter weight (kg)" style="whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="146" width="200" height="44" as="geometry"/></mxCell><mxCell id="n4" value="Tap Submit&lt;br&gt;&lt;i&gt;timestamp fixed on first attempt&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="220" width="200" height="56" as="geometry"/></mxCell><mxCell id="n5" value="Submitting...&lt;br&gt;&lt;i&gt;3 s delay, button disabled&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="306" width="200" height="56" as="geometry"/></mxCell><mxCell id="n6" value="Response?" style="whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="392" width="180" height="100" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Network failure&lt;/b&gt;&lt;br&gt;&lt;i&gt;no response or 10 s timeout&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="330" y="532" width="200" height="56" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Preserve state&lt;/b&gt;&lt;br&gt;QR ID, weight and timestamp&lt;br&gt;stay in the Redux store" style="whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="330" y="618" width="200" height="70" as="geometry"/></mxCell><mxCell id="n9" value="Show message&lt;br&gt;&lt;i&gt;Unable to reach the server.&lt;br&gt;Please try again.&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="330" y="718" width="200" height="70" as="geometry"/></mxCell><mxCell id="n10" value="User taps &lt;b&gt;Retry&lt;/b&gt;&lt;br&gt;&lt;i&gt;same payload is sent again&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="818" width="200" height="56" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;201 Created&lt;/b&gt;&lt;br&gt;Collection submitted successfully." style="whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="412" width="200" height="60" as="geometry"/></mxCell><mxCell id="n12" value="Scan next bag&lt;br&gt;&lt;i&gt;state reset only now&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="512" width="200" height="56" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;409&lt;/b&gt;&lt;br&gt;This bag has already been collected." style="whiteSpace=wrap;html=1;fontSize=1